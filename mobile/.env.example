# Copie para .env e ajuste. O Expo lê variáveis EXPO_PUBLIC_* na hora de iniciar (npx expo start).

# Endereço do backend. No celular físico use o IP do computador na rede (ex.: http://192.168.0.10:8000).
# No emulador Android: http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Chave publicável do Stripe em modo de teste (pk_test_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
