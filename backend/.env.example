# ==============================================================================
# Aloogaí Backend — Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com credenciais reais!
# ==============================================================================

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte-e-unica
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Banco de Dados (PostgreSQL + PostGIS) ---
POSTGRES_DB=aloogai_db
POSTGRES_USER=aloogai
POSTGRES_PASSWORD=sua-senha-segura-aqui
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
CORS_ALLOW_ALL_ORIGINS=False

# --- Stripe Connect ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- AWS S3 (Armazenamento de Mídia) ---
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_STORAGE_BUCKET_NAME=aloogai-media
AWS_S3_REGION_NAME=sa-east-1

# --- E-mail (Produção) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@aloogai.com.br
EMAIL_HOST_PASSWORD=sua-senha-de-app-aqui
DEFAULT_FROM_EMAIL=Aloogaí <noreply@aloogai.com.br>

# --- Sentry (Produção) ---
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Aloogaí — Regras de Negócio ---
ALOOGAI_TAXA_SERVICO_LOCATARIO=0.10
ALOOGAI_TAXA_SUCESSO_LOCADOR=0.15

# --- Versão ---
APP_VERSION=0.1.0
