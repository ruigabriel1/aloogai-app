# Variáveis do docker compose (copie para .env — o .env fica fora do git).

# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Stripe em modo de teste: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook local: `stripe listen --forward-to localhost:8000/api/v1/payments/webhooks/stripe/`
# mostra o whsec_... a colocar aqui (opcional: o app também confirma o pagamento direto no Stripe)
STRIPE_WEBHOOK_SECRET=whsec_...
